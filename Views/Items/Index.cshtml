@model ItemsIndexViewModel
@{
    ViewData["Title"] = "Produtos";
    var statusMessage = TempData["StatusMessage"] as string;

    static string FormatPrice(decimal? value) => value.HasValue ? value.Value.ToString("C") : "-";
}

<section class="materials-shell">
    <div class="materials-page-header">
        <div>
            <span class="materials-kicker">Catálogo da fábrica</span>
            <h1>@ViewData["Title"]</h1>
            <p>Cadastre o que a fábrica produz, como caneco 12 e caneca 16. Defina os materiais de cada peça e seus preços de venda.</p>
        </div>
        <a class="btn btn-primary btn-lg" asp-action="Create">Novo produto</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-@(TempData["StatusKind"] as string == "warning" ? "warning" : "success") materials-status" role="alert">
            @statusMessage
        </div>
    }

    <div class="materials-summary-grid">
        <article class="materials-card materials-summary-card">
            <span class="materials-summary-label">Produtos cadastrados</span>
            <strong>@Model.Itens.Count</strong>
            <p>Disponíveis para registrar no estoque e incluir em pedidos.</p>
        </article>
    </div>

    <div class="materials-card">
        <div class="materials-section-head">
            <div>
                <h2>Catálogo de produtos</h2>
                <p>O cadastro define a composição. As quantidades prontas ficam no Estoque.</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table materials-table align-middle" data-search-label="Buscar produto por nome ou número">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Disco principal</th>
                        <th>Tampa</th>
                        <th>Promocional</th>
                        <th>Atacado</th>
                        <th>Varejo</th>
                        <th>Acessórios</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Itens.Any())
                {
                    <tr>
                        <td colspan="8" class="materials-empty">Nenhum produto cadastrado. Use Novo produto para começar.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Itens)
                    {
                        <tr>
                            <td>
                                <strong>@item.NomeDisplay</strong>
                            </td>
                            <td>@item.DiscoPrincipal</td>
                            <td>
                                @if (item.PossuiTampa)
                                {
                                    @item.DiscoTampa
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@FormatPrice(item.PrecoPromocional)</td>
                            <td>@FormatPrice(item.PrecoAtacado)</td>
                            <td>@FormatPrice(item.PrecoVarejo)</td>
                            <td>@item.AcessoriosResumo</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#confirmDeleteModal"
                                            data-delete-url="@Url.Action("Delete")"
                                            data-item-id="@item.Id"
                                            data-item-name="@item.NomeDisplay">
                                        Excluir
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteLabel">Confirmar exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                Tem certeza que deseja excluir <strong id="delete-item-name"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="delete-item-id" />
                    <button type="submit" class="btn btn-danger">Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('confirmDeleteModal');
            if (!deleteModal) return;

            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                if (!button) return;

                document.getElementById('delete-item-name').textContent = button.getAttribute('data-item-name') ?? '';
                document.getElementById('delete-item-id').value = button.getAttribute('data-item-id') ?? '';
                document.getElementById('deleteForm').setAttribute('action', button.getAttribute('data-delete-url'));
            });
        });
    </script>
}
