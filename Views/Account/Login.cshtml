@model Fabrica.Models.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<section class="auth-container">
    <div class="card shadow-sm p-4 auth-card">
        <span class="materials-kicker mb-3">FÁBRICA MACIEL</span>
        <h1 class="mb-2">Bem-vindo à fábrica</h1>
        <p class="text-muted mb-4">Entre com seu acesso para cuidar dos pedidos e do estoque.</p>
        @if (TempData["RegisterMessage"] is string registerMessage && !string.IsNullOrWhiteSpace(registerMessage))
        {
            <div class="alert alert-success" role="alert">
                @registerMessage
            </div>
        }
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 flex-column flex-md-row">
                <button type="submit" class="btn btn-primary flex-fill">Entrar</button>
            </div>
        </form>
        <p class="text-muted small mt-4 mb-0">Precisa de acesso ou esqueceu sua senha? Procure o administrador da fábrica.</p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
