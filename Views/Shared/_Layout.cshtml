@inject Fabrica.Services.ILoginCacheService LoginCache
@{
    var isLogged = LoginCache.TryGetLoggedUser(Context.Session.Id, out var loggedUser);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var navigation = new List<(string Controller, string Label)> { ("Home", "Visão geral"), ("Pedidos", "Pedidos"), ("Estoque", "Estoque") };
    var catalogs = new List<(string Controller, string Label)> { ("Materials", "Materiais"), ("Items", "Produtos"), ("AdminUsers", "Usuários") };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Fábrica Maciel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
</head>
<body class="@(isLogged ? "workspace" : "login-page")">
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    @if (isLogged)
    {
        <aside class="workspace-sidebar">
            <div class="workspace-brand"><span class="brand-mark" aria-hidden="true">FM</span><div>Fábrica Maciel<small>Gestão da fábrica</small></div></div>
            <button class="mobile-menu-button btn btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#workspace-navigation" aria-controls="workspace-navigation" aria-expanded="false">Menu</button>
            <div class="collapse workspace-navigation" id="workspace-navigation">
            <nav aria-label="Navegação principal">
                <p class="nav-caption">DIA A DIA</p>
                @foreach (var entry in navigation)
                {
                    <a asp-controller="@entry.Controller" asp-action="Index" class="workspace-link @(controller == entry.Controller ? "active" : "")" aria-current="@(controller == entry.Controller ? "page" : null)">@entry.Label</a>
                }
                @if (loggedUser?.NivelAcessoId == 1)
                {
                    <p class="nav-caption">CADASTROS</p>
                    @foreach (var entry in catalogs)
                    {
                        <a asp-controller="@entry.Controller" asp-action="Index" class="workspace-link @(controller == entry.Controller ? "active" : "")" aria-current="@(controller == entry.Controller ? "page" : null)">@entry.Label</a>
                    }
                }
            </nav>
            <div class="workspace-account"><strong>@loggedUser?.Name</strong><small>@(loggedUser?.NivelAcessoId == 1 ? "Administrador" : "Equipe da fábrica")</small><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm" type="submit">Sair do sistema</button></form></div>
            </div>
        </aside>
    }
    <div class="workspace-main">
        @if (isLogged)
        {
            <header class="workspace-topbar"><span>@ViewData["Title"]</span><span class="text-muted">@DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy")</span></header>
        }
        <main id="main-content" class="workspace-content" tabindex="-1">@RenderBody()</main>
        <footer class="workspace-footer">Fábrica Maciel · Materiais, produção e pedidos em um só lugar.</footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
