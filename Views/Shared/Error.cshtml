@model ErrorViewModel
@{
    ViewData["Title"] = "Não foi possível concluir";
}

<h1>Não foi possível concluir esta ação</h1>
<p>Tente novamente. Se o problema continuar, informe o administrador do sistema.</p>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar à visão geral</a>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Referência para atendimento:</strong> <code>@Model.RequestId</code>
    </p>
}
